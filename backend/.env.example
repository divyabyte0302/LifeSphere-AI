# LifeSphere AI-X Backend Configuration Environment Template
# Academic & Research Prototype — Not for Unauthenticated Production Deployment

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Allowed CORS Origins (comma-separated frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Firebase Admin Configuration
# Option A: Service Account JSON file path (Recommended for dedicated servers/local development)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# Option B: Raw Service Account JSON string or base64 (For container environments like Cloud Run)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option C: Firebase Project ID (Uses Google Application Default Credentials or Mock Mode)
FIREBASE_PROJECT_ID=lifesphere-ai-production

# Development & Testing Mode:
# When true, enables mock token verification and in-memory fallback for local unit tests without real GCP credentials
FIREBASE_MOCK_AUTH_FOR_DEV=false
