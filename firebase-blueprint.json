{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with role claims (USER, DOCTOR, ADMIN). Complete medical records are strictly separated for least privilege.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["USER", "DOCTOR", "ADMIN"] },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "PENDING_MFA"] },
        "emailVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role", "status", "createdAt"]
    },
    "MedicalRecord": {
      "title": "Clinical Medical Record",
      "description": "Sensitive protected health information (PHI). Resticted to patient and assigned DOCTOR. Never accessible to ADMIN by default.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "category": { "type": "string", "maxLength": 64 },
        "diagnosis": { "type": "string", "maxLength": 1024 },
        "assignedDoctorId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "category", "createdAt"]
    },
    "SystemMetric": {
      "title": "Infrastructure Metric",
      "description": "Cluster CPU, memory, uptime, and microservice status. Accessible only to ADMIN role.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "cpuUsagePercent": { "type": "number" },
        "memoryUsagePercent": { "type": "number" },
        "activeContainerInstances": { "type": "integer" },
        "platformUptimePercent": { "type": "number" },
        "status": { "type": "string", "enum": ["OPTIMAL", "DEGRADED", "CRITICAL"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "cpuUsagePercent", "memoryUsagePercent", "status", "timestamp"]
    },
    "SecurityEvent": {
      "title": "Security Threat Event",
      "description": "SIEM logs of brute-force attempts, unauthorized access blocks, and key rotations.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "eventType": { "type": "string", "maxLength": 128 },
        "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
        "sourceIp": { "type": "string", "maxLength": 64 },
        "details": { "type": "string", "maxLength": 1024 },
        "status": { "type": "string", "enum": ["BLOCKED", "MITIGATED", "AUDITED", "FLAGGED"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "eventType", "severity", "sourceIp", "status", "timestamp"]
    },
    "AuditLog": {
      "title": "HIPAA Audit Trail Entry",
      "description": "Immutable append-only compliance audit trail under HIPAA § 164.312(b).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "actor": { "type": "string", "maxLength": 128 },
        "actorRole": { "type": "string", "enum": ["ADMIN", "SYSTEM", "DOCTOR", "USER"] },
        "action": { "type": "string", "maxLength": 128 },
        "resource": { "type": "string", "maxLength": 256 },
        "outcome": { "type": "string", "enum": ["SUCCESS", "DENIED", "FLAGGED"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actor", "actorRole", "action", "outcome", "timestamp"]
    },
    "PatientAuthorization": {
      "title": "Patient Authorization & Consent",
      "description": "Patient authorization grant and revocation record. Doctors only see patients who have explicitly authorized access.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "patientId": { "type": "string", "maxLength": 128 },
        "patientName": { "type": "string", "maxLength": 128 },
        "doctorId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["AUTHORIZED", "REVOKED", "EXPIRED"] },
        "grantedAt": { "type": "string", "format": "date-time" },
        "revokedAt": { "type": "string" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "patientId", "doctorId", "status", "grantedAt", "expiresAt"]
    },
    "DoctorCareNote": {
      "title": "Doctor Care Note & Directives",
      "description": "Physician-entered care directives and recommendations. Protected from silent AI overwrites with physician override lock.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "patientId": { "type": "string", "maxLength": 128 },
        "doctorId": { "type": "string", "maxLength": 128 },
        "doctorName": { "type": "string", "maxLength": 128 },
        "recommendations": { "type": "array", "items": { "type": "string" } },
        "followUpDate": { "type": "string" },
        "careInstructions": { "type": "string", "maxLength": 2048 },
        "carePlanInformation": { "type": "string", "maxLength": 2048 },
        "isPhysicianOverride": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "patientId", "doctorId", "careInstructions", "isPhysicianOverride", "createdAt"]
    },
    "DoctorAccessLog": {
      "title": "Doctor Access Audit Log",
      "description": "Immutable log of every physician access to patient charts, reports, and timelines under HIPAA § 164.506/164.312(b).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "doctorId": { "type": "string", "maxLength": 128 },
        "doctorName": { "type": "string", "maxLength": 128 },
        "patientId": { "type": "string", "maxLength": 128 },
        "accessedFeature": { "type": "string", "maxLength": 64 },
        "timestamp": { "type": "string", "format": "date-time" },
        "purposeOfAccess": { "type": "string", "maxLength": 256 },
        "clientIp": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "doctorId", "patientId", "accessedFeature", "timestamp", "purposeOfAccess"]
    },
    "HydrationRecord": {
      "title": "Daily Water Intake & Hydration Entry",
      "description": "User logged fluid intake entries with volume, beverage type, effective hydration, and timestamps.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "volumeMl": { "type": "number" },
        "effectiveMl": { "type": "number" },
        "beverageType": { "type": "string", "maxLength": 64 },
        "source": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 512 },
        "timestamp": { "type": "string", "format": "date-time" },
        "timeFormatted": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "volumeMl", "effectiveMl", "beverageType", "timestamp"]
    },
    "Appointment": {
      "title": "Health Checkup Appointment & Recurring Reminder",
      "description": "Patient health appointments with monthly recurring reminder support, delivery confirmation tracking, and timezone compliance.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 1024 },
        "doctorOrSpecialist": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "enum": ["routine_checkup", "cardiology", "pulmonology", "allergy_immunology", "annual_physical", "lab_work", "telehealth"] },
        "scheduledDateTime": { "type": "string", "format": "date-time" },
        "durationMinutes": { "type": "integer" },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled", "missed"] },
        "frequency": { "type": "string", "enum": ["once", "monthly", "quarterly", "annual"] },
        "nextRecurrenceDate": { "type": "string" },
        "location": { "type": "string", "maxLength": 256 },
        "isTelehealth": { "type": "boolean" },
        "telehealthLink": { "type": "string", "maxLength": 512 },
        "reminderPreferences": { "type": "object" },
        "notificationDeliveryStatus": { "type": "string", "enum": ["scheduled", "delivered", "dismissed", "failed"] },
        "deliveryTimestamp": { "type": "string" },
        "notes": { "type": "string", "maxLength": 1024 },
        "completedAt": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "scheduledDateTime", "status", "frequency", "createdAt"]
    },
    "HealthAnalyticsObservation": {
      "title": "Health Analytics Biomarker Observation",
      "description": "Longitudinal biomarker data points for heart rate, blood pressure, sleep stages, temperature, and environmental AQI correlation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "metricType": { "type": "string", "enum": ["heart_rate", "blood_pressure", "sleep", "temperature", "steps", "aqi_exposure", "risk_score"] },
        "value": { "type": "number" },
        "secondaryValue": { "type": "number" },
        "unit": { "type": "string", "maxLength": 32 },
        "siteOrStage": { "type": "string", "maxLength": 64 },
        "isSimulated": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "metricType", "value", "timestamp"]
    },
    "EmergencyContact": {
      "title": "Registered Emergency Contact",
      "description": "User-registered emergency contact with relationship, contact channels, and explicit consent.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "relationship": { "type": "string", "maxLength": 64 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 128 },
        "isPrimary": { "type": "boolean" },
        "hasExplicitConsent": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "relationship", "phone", "hasExplicitConsent"]
    },
    "EmergencyAlertRule": {
      "title": "Emergency Alert Rule",
      "description": "Configurable abnormal reading detection rule and threshold.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "metric": { "type": "string", "maxLength": 64 },
        "condition": { "type": "string", "enum": ["greater_than", "less_than"] },
        "threshold": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "severity": { "type": "string", "enum": ["low", "moderate", "high", "critical"] },
        "isEnabled": { "type": "boolean" }
      },
      "required": ["id", "userId", "name", "metric", "condition", "threshold", "severity", "isEnabled"]
    },
    "EmergencyEventRecord": {
      "title": "Emergency Event Record",
      "description": "Log of manual SOS or automated emergency trigger with telemetry, notifications, and acknowledgements.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "triggerType": { "type": "string", "enum": ["MANUAL_SOS", "AUTOMATED_RULE_TRIGGER"] },
        "title": { "type": "string", "maxLength": 256 },
        "severity": { "type": "string", "enum": ["low", "moderate", "high", "critical"] },
        "reason": { "type": "string", "maxLength": 1024 },
        "status": { "type": "string", "enum": ["active", "acknowledged", "escalated", "resolved", "cancelled"] },
        "triggeredAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "triggerType", "title", "severity", "status", "triggeredAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "User profiles and RBAC role assignments."
    },
    "/users/{userId}/hydration/{recordId}": {
      "schema": "#/entities/HydrationRecord",
      "description": "Daily water intake entries and dynamic fluid tracking per user."
    },
    "/users/{userId}/appointments/{appointmentId}": {
      "schema": "#/entities/Appointment",
      "description": "Health checkup appointments and monthly recurring reminders."
    },
    "/users/{userId}/analytics_records/{recordId}": {
      "schema": "#/entities/HealthAnalyticsObservation",
      "description": "Biomarker historical records and longitudinal analytics."
    },
    "/users/{userId}/emergency_contacts/{contactId}": {
      "schema": "#/entities/EmergencyContact",
      "description": "Registered emergency contacts with verified permissions."
    },
    "/users/{userId}/emergency_rules/{ruleId}": {
      "schema": "#/entities/EmergencyAlertRule",
      "description": "Configurable threshold and data-quality rules."
    },
    "/users/{userId}/emergency_events/{eventId}": {
      "schema": "#/entities/EmergencyEventRecord",
      "description": "Emergency incident audit logs with delivery acknowledgements."
    },
    "/medical_records/{recordId}": {
      "schema": "#/entities/MedicalRecord",
      "description": "Protected Health Information (PHI). Zero default access for administrators."
    },
    "/system_metrics/{metricId}": {
      "schema": "#/entities/SystemMetric",
      "description": "Platform infrastructure metrics, restricted to verified ADMIN role."
    },
    "/security_events/{eventId}": {
      "schema": "#/entities/SecurityEvent",
      "description": "Security incident and threat events, restricted to verified ADMIN role."
    },
    "/audit_logs/{logId}": {
      "schema": "#/entities/AuditLog",
      "description": "Immutable append-only audit trail logs."
    },
    "/patient_authorizations/{authId}": {
      "schema": "#/entities/PatientAuthorization",
      "description": "Patient consent records governing physician chart access."
    },
    "/doctor_care_notes/{noteId}": {
      "schema": "#/entities/DoctorCareNote",
      "description": "Physician-entered care directives with override protection against AI alteration."
    },
    "/doctor_access_logs/{logId}": {
      "schema": "#/entities/DoctorAccessLog",
      "description": "Immutable audit logs of all doctor accesses to patient data."
    }
  }
}
